{% render 'partials/head.liquid' %}

{% render 'partials/menu.liquid' %}

<button class="go-back-btn" onclick="history.back()"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left-icon lucide-arrow-left"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg><span>Ga terug</span></button>
<section class="grid-container">
    <article class="test-news">
        {% if story.cover.id %}
            <img class="no-hover" src="https://fdnd-agency.directus.app/assets/{{ story.cover.id }}" alt="">
        {% else %}
            <img class="no-hover" src="/afbnotfound.svg" alt="Geen afbeelding beschikbaar">
        {% endif %}

        {% if story.target_group %}
            <p class="target">{{ story.target_group }}</p>
        {% else %}
            <p class="target">jong & oud</p>
        {% endif %}

        <h1 class="h1-detailpage">{{ story.title }}</h1>
        <p class="intro-detailpage">{{ story.intro }}</p>
        <div class="body-detailpage">{{ story.body }}</div>
    </article>
</section>

{% render 'partials/foot.liquid' %}